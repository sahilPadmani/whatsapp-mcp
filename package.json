{
    "name": "whatsapp-mcp",
    "version": "0.1.0",
    "description": "MCP server that gives AI agents safe access to WhatsApp: read, receive, reply, media and reactions, with encrypted storage and phone numbers that never leave the server.",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "whatsapp",
        "baileys",
        "ai-agents",
        "claude",
        "llm-tools"
    ],
    "homepage": "https://github.com/sahilPadmani/whatsapp-mcp#readme",
    "bugs": {
        "url": "https://github.com/sahilPadmani/whatsapp-mcp/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sahilPadmani/whatsapp-mcp.git"
    },
    "license": "MIT",
    "author": "Sahil Padmani",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.13"
    },
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "start": "node --env-file-if-exists=.env dist/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node --import tsx --test --test-reporter=spec 'test/**/*.test.ts'",
        "check": "npm run lint && npm run typecheck && npm run format:check && npm run test:coverage",
        "test:unit": "node --import tsx --test --test-reporter=spec 'test/unit/**/*.test.ts'",
        "test:integration": "node --import tsx --test --test-reporter=spec 'test/integration/**/*.test.ts'",
        "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/index.ts' --test-coverage-lines=85 --test-coverage-branches=80 --test-coverage-functions=80 'test/**/*.test.ts'"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.1",
        "baileys": "^7.0.0-rc14",
        "express": "^5.3.0",
        "pino": "^10.4.0",
        "qrcode": "^1.5.4",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "@types/qrcode": "^1.5.6",
        "eslint": "^10.13.0",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.0"
    }
}
