# WhatsApp MCP Server: configuration
#
# Copy this file to `.env` (cp .env.example .env). Every setting is listed with its default.
# Empty values mean "not set". API_KEY and ENCRYPTION_KEY are generated into .env
# automatically on first start if they are empty.

# ─── Server ─────────────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
# Port and interface to listen on. Keep 127.0.0.1 unless you put a TLS reverse proxy in front.
PORT=3000
HOST=127.0.0.1
# Public base URL (used in the printed login link). Defaults to http://HOST:PORT.
# Set it when running behind a reverse proxy, e.g. https://whatsapp-mcp.example.com
PUBLIC_URL=
# Log levels: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=error

# ─── Secrets (auto-generated on first start if empty) ───────────────────────────
# Bearer token MCP clients must send: "Authorization: Bearer <API_KEY>". At least 16 characters.
# Generate: openssl rand -hex 24
API_KEY=
# 32 random bytes, base64. Encrypts everything stored at rest (session, messages, contacts, media).
# Generate: openssl rand -base64 32
# BACK IT UP: if it is lost, stored data can't be decrypted and you must log in again.
ENCRYPTION_KEY=

# ─── Storage ────────────────────────────────────────────────────────────────────
# Encrypted SQLite database + encrypted media cache.
DATA_DIR=./data

# ─── Sending: anti-ban limits and human-like behaviour ───────────────────────────
# Minimum time between two outgoing messages/reactions, and the hourly cap.
SEND_MIN_INTERVAL_MS=3000
SEND_MAX_PER_HOUR=30
# Show "typing…" before each message for (characters × TYPING_MS_PER_CHAR), clamped to [MIN, MAX].
HUMANIZE_REPLIES=true
TYPING_MS_PER_CHAR=40
TYPING_MIN_MS=1000
TYPING_MAX_MS=8000
# Allow send_message/send_media to a phone number with country code (write-only: never returned).
ALLOW_SEND_TO_PHONE=true
# Max new conversations (people you never messaged before) per 24 h. Unsolicited messages get numbers banned.
NEW_CHAT_MAX_PER_DAY=10

# ─── Media ──────────────────────────────────────────────────────────────────────
# Largest file (bytes) the server downloads, sends or returns to an agent. Default 16 MB.
MEDIA_MAX_BYTES=16777216
# Directory that send_media(file_path) may read from. Empty = only base64 uploads are allowed.
MEDIA_SEND_DIR=

# ─── Webhook (optional): POST every incoming message/reaction to your service ───
# Example: https://example.com/whatsapp-webhook
WEBHOOK_URL=
# Required when WEBHOOK_URL is set; at least 16 characters. Used for the HMAC-SHA256 signature.
WEBHOOK_SECRET=
WEBHOOK_MAX_ATTEMPTS=10

# ─── MCP ────────────────────────────────────────────────────────────────────────
# Idle MCP sessions are closed after this many milliseconds (default 30 minutes).
MCP_SESSION_IDLE_MS=1800000
# Toolsets to expose: all, or a comma list of: status,chats,messages,sending,media,reactions
TOOLSETS=all
